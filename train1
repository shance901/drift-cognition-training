<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DRIFT COGNITION — Explosive Safety Training</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Barlow+Condensed:wght@300;400;600;700;900&family=Barlow:wght@300;400;600&display=swap');

:root {
–black: #050608;
–void: #0a0c10;
–panel: #0f1218;
–border: #1e2530;
–accent: #c8372d;
–accent2: #e85d1a;
–warn: #f0b429;
–green: #2eb87e;
–muted: #4a5568;
–mid: #8896aa;
–light: #c8d4e0;
–white: #eef2f7;
–mono: ‘Share Tech Mono’, monospace;
–cond: ‘Barlow Condensed’, sans-serif;
–body: ‘Barlow’, sans-serif;
}

- { margin: 0; padding: 0; box-sizing: border-box; }

body {
background: var(–black);
color: var(–light);
font-family: var(–body);
min-height: 100vh;
overflow-x: hidden;
}

/* SCANLINE OVERLAY */
body::before {
content: ‘’;
position: fixed;
inset: 0;
background: repeating-linear-gradient(
0deg,
transparent,
transparent 2px,
rgba(0,0,0,0.08) 2px,
rgba(0,0,0,0.08) 4px
);
pointer-events: none;
z-index: 9999;
}

/* HEADER */
header {
position: relative;
padding: 60px 40px 40px;
border-bottom: 1px solid var(–border);
overflow: hidden;
}

header::before {
content: ‘’;
position: absolute;
top: 0; left: 0; right: 0;
height: 3px;
background: linear-gradient(90deg, var(–accent), var(–accent2), var(–warn));
}

.header-grid {
display: grid;
grid-template-columns: 1fr auto;
gap: 20px;
align-items: start;
max-width: 1100px;
margin: 0 auto;
}

.classification {
font-family: var(–mono);
font-size: 10px;
letter-spacing: 0.3em;
color: var(–accent);
margin-bottom: 16px;
animation: blink 2s step-end infinite;
}

@keyframes blink {
0%, 100% { opacity: 1; }
50% { opacity: 0.4; }
}

h1 {
font-family: var(–cond);
font-weight: 900;
font-size: clamp(48px, 8vw, 96px);
line-height: 0.9;
letter-spacing: -0.02em;
text-transform: uppercase;
color: var(–white);
}

h1 span {
display: block;
color: var(–accent);
}

.header-sub {
font-family: var(–cond);
font-weight: 300;
font-size: 18px;
letter-spacing: 0.15em;
text-transform: uppercase;
color: var(–mid);
margin-top: 12px;
}

.header-meta {
text-align: right;
}

.meta-item {
font-family: var(–mono);
font-size: 11px;
color: var(–muted);
line-height: 2;
}

.meta-item strong {
color: var(–warn);
display: block;
}

/* DOCTRINE BOX */
.doctrine {
max-width: 1100px;
margin: 40px auto;
padding: 0 40px;
}

.doctrine-quote {
position: relative;
background: var(–panel);
border: 1px solid var(–border);
border-left: 4px solid var(–accent);
padding: 28px 36px;
font-family: var(–cond);
font-size: 24px;
font-weight: 600;
letter-spacing: 0.04em;
color: var(–warn);
text-transform: uppercase;
}

.doctrine-quote::after {
content: ‘CORE DOCTRINE’;
position: absolute;
top: -10px;
right: 20px;
font-family: var(–mono);
font-size: 9px;
letter-spacing: 0.3em;
color: var(–accent);
background: var(–panel);
padding: 2px 8px;
}

/* MAIN GRID */
main {
max-width: 1100px;
margin: 0 auto;
padding: 20px 40px 80px;
}

/* SECTION HEADERS */
.section-label {
font-family: var(–mono);
font-size: 10px;
letter-spacing: 0.4em;
color: var(–accent);
text-transform: uppercase;
margin-bottom: 24px;
margin-top: 60px;
display: flex;
align-items: center;
gap: 16px;
}

.section-label::after {
content: ‘’;
flex: 1;
height: 1px;
background: var(–border);
}

/* LAYER CARDS */
.layers-grid {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 2px;
margin-bottom: 2px;
}

.layer-card {
background: var(–panel);
border: 1px solid var(–border);
padding: 32px;
position: relative;
overflow: hidden;
cursor: pointer;
transition: border-color 0.2s, background 0.2s;
}

.layer-card:hover {
background: #131820;
border-color: var(–accent);
}

.layer-card::before {
content: attr(data-num);
position: absolute;
top: -10px;
right: 16px;
font-family: var(–cond);
font-weight: 900;
font-size: 120px;
color: rgba(255,255,255,0.03);
line-height: 1;
pointer-events: none;
}

.layer-tag {
font-family: var(–mono);
font-size: 9px;
letter-spacing: 0.3em;
color: var(–accent);
margin-bottom: 10px;
text-transform: uppercase;
}

.layer-title {
font-family: var(–cond);
font-weight: 700;
font-size: 28px;
color: var(–white);
text-transform: uppercase;
line-height: 1.1;
margin-bottom: 8px;
}

.layer-sub {
font-family: var(–cond);
font-weight: 300;
font-size: 15px;
color: var(–warn);
letter-spacing: 0.05em;
margin-bottom: 20px;
font-style: italic;
}

.layer-list {
list-style: none;
}

.layer-list li {
font-size: 13px;
color: var(–mid);
line-height: 1.8;
padding-left: 16px;
position: relative;
}

.layer-list li::before {
content: ‘→’;
position: absolute;
left: 0;
color: var(–accent);
font-family: var(–mono);
font-size: 11px;
}

/* DRIFT LOOP */
.loop-section {
background: var(–panel);
border: 1px solid var(–border);
padding: 40px;
position: relative;
}

.loop-section::before {
content: ‘THE DRIFT LOOP — INTERRUPT AT STAGE 1 OR 2’;
position: absolute;
top: -10px;
left: 24px;
font-family: var(–mono);
font-size: 9px;
letter-spacing: 0.3em;
color: var(–warn);
background: var(–panel);
padding: 2px 10px;
}

.loop-stages {
display: flex;
align-items: stretch;
gap: 0;
margin-top: 20px;
}

.loop-stage {
flex: 1;
position: relative;
padding: 24px 20px;
border: 1px solid var(–border);
text-align: center;
transition: background 0.2s;
}

.loop-stage:hover { background: rgba(200,55,45,0.06); }

.loop-stage + .loop-stage {
border-left: none;
}

.loop-stage::after {
content: ‘▶’;
position: absolute;
right: -10px;
top: 50%;
transform: translateY(-50%);
color: var(–accent);
font-size: 12px;
z-index: 2;
}

.loop-stage:last-child::after { display: none; }

.stage-num {
font-family: var(–mono);
font-size: 9px;
color: var(–muted);
letter-spacing: 0.3em;
margin-bottom: 8px;
}

.stage-name {
font-family: var(–cond);
font-weight: 700;
font-size: 16px;
text-transform: uppercase;
line-height: 1.2;
margin-bottom: 6px;
}

.stage-desc {
font-size: 11px;
color: var(–mid);
line-height: 1.5;
}

.stage-1 .stage-name { color: var(–green); }
.stage-2 .stage-name { color: var(–warn); }
.stage-3 .stage-name { color: var(–accent2); }
.stage-4 .stage-name { color: var(–accent); }
.stage-5 .stage-name { color: var(–accent); font-size: 20px; }

.stage-5 {
background: rgba(200,55,45,0.08);
border-color: var(–accent) !important;
}

.interrupt-zone {
margin-top: 20px;
padding: 14px 20px;
background: rgba(46,184,126,0.08);
border: 1px solid rgba(46,184,126,0.3);
border-left: 3px solid var(–green);
display: flex;
align-items: center;
gap: 16px;
}

.interrupt-label {
font-family: var(–mono);
font-size: 10px;
letter-spacing: 0.25em;
color: var(–green);
white-space: nowrap;
}

.interrupt-text {
font-size: 13px;
color: var(–mid);
line-height: 1.5;
}

/* RED FLAGS */
.redflags-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
gap: 2px;
}

.redflag {
background: var(–panel);
border: 1px solid var(–border);
border-left: 3px solid var(–accent);
padding: 18px 22px;
position: relative;
transition: background 0.2s;
}

.redflag:hover {
background: rgba(200,55,45,0.06);
}

.redflag::before {
content: ‘⚑’;
position: absolute;
top: 16px;
right: 16px;
color: var(–accent);
opacity: 0.4;
font-size: 14px;
}

.redflag-quote {
font-family: var(–cond);
font-size: 15px;
font-style: italic;
color: var(–warn);
margin-bottom: 6px;
}

.redflag-type {
font-family: var(–mono);
font-size: 9px;
letter-spacing: 0.25em;
color: var(–muted);
}

/* TRAINING OBJECTIVES */
.objectives-grid {
display: grid;
grid-template-columns: 1fr 1fr 1fr;
gap: 2px;
}

.objective {
background: var(–panel);
border: 1px solid var(–border);
padding: 28px 24px;
position: relative;
overflow: hidden;
transition: background 0.2s, border-color 0.2s;
}

.objective:hover {
background: #131820;
border-color: var(–accent2);
}

.obj-icon {
font-size: 28px;
margin-bottom: 12px;
display: block;
}

.obj-title {
font-family: var(–cond);
font-weight: 700;
font-size: 18px;
text-transform: uppercase;
color: var(–white);
margin-bottom: 8px;
letter-spacing: 0.05em;
}

.obj-desc {
font-size: 13px;
color: var(–mid);
line-height: 1.7;
}

/* ACCUMULATION */
.accum-section {
background: var(–panel);
border: 1px solid var(–border);
padding: 40px;
}

.accum-chain {
display: flex;
flex-direction: column;
gap: 0;
margin-top: 24px;
}

.chain-item {
display: flex;
align-items: flex-start;
gap: 20px;
padding: 16px 0;
border-bottom: 1px solid var(–border);
position: relative;
animation: fadeIn 0.5s ease both;
}

@keyframes fadeIn {
from { opacity: 0; transform: translateX(-10px); }
to { opacity: 1; transform: translateX(0); }
}

.chain-item:last-child { border-bottom: none; }

.chain-dot {
width: 32px;
height: 32px;
border-radius: 50%;
border: 2px solid;
display: flex;
align-items: center;
justify-content: center;
font-family: var(–mono);
font-size: 11px;
flex-shrink: 0;
margin-top: 2px;
}

.chain-item:nth-child(1) .chain-dot { border-color: var(–green); color: var(–green); }
.chain-item:nth-child(2) .chain-dot { border-color: var(–warn); color: var(–warn); }
.chain-item:nth-child(3) .chain-dot { border-color: var(–accent2); color: var(–accent2); }
.chain-item:nth-child(4) .chain-dot { border-color: var(–accent); color: var(–accent); background: rgba(200,55,45,0.1); }

.chain-body {}

.chain-label {
font-family: var(–mono);
font-size: 9px;
letter-spacing: 0.3em;
color: var(–muted);
margin-bottom: 4px;
}

.chain-text {
font-family: var(–cond);
font-size: 18px;
color: var(–light);
line-height: 1.3;
}

.chain-arrow {
margin-left: 16px;
text-align: center;
color: var(–accent);
font-size: 18px;
padding: 4px 0;
font-family: var(–mono);
display: block;
}

/* QUIZ SECTION */
.quiz-section {
background: var(–panel);
border: 1px solid var(–border);
padding: 40px;
position: relative;
}

.quiz-section::before {
content: ‘COMPETENCY CHECK’;
position: absolute;
top: -10px;
left: 24px;
font-family: var(–mono);
font-size: 9px;
letter-spacing: 0.3em;
color: var(–accent);
background: var(–panel);
padding: 2px 10px;
}

.quiz-q {
margin-bottom: 32px;
}

.quiz-text {
font-family: var(–cond);
font-size: 20px;
font-weight: 600;
color: var(–white);
margin-bottom: 16px;
}

.quiz-options {
display: flex;
flex-direction: column;
gap: 8px;
}

.quiz-option {
background: transparent;
border: 1px solid var(–border);
color: var(–mid);
padding: 12px 18px;
text-align: left;
font-family: var(–body);
font-size: 14px;
cursor: pointer;
transition: all 0.15s;
display: flex;
align-items: center;
gap: 12px;
}

.quiz-option:hover {
background: rgba(255,255,255,0.03);
border-color: var(–mid);
color: var(–light);
}

.quiz-option.correct {
background: rgba(46,184,126,0.1);
border-color: var(–green);
color: var(–green);
}

.quiz-option.wrong {
background: rgba(200,55,45,0.1);
border-color: var(–accent);
color: var(–accent);
}

.quiz-option.disabled {
cursor: default;
pointer-events: none;
}

.opt-letter {
font-family: var(–mono);
font-size: 10px;
width: 20px;
flex-shrink: 0;
color: var(–muted);
}

.feedback {
margin-top: 12px;
padding: 12px 16px;
font-size: 13px;
border-left: 3px solid;
display: none;
line-height: 1.6;
}

.feedback.show { display: block; }
.feedback.correct-fb { border-color: var(–green); color: var(–green); background: rgba(46,184,126,0.06); }
.feedback.wrong-fb { border-color: var(–accent); color: var(–accent); background: rgba(200,55,45,0.06); }

/* FOOTER */
footer {
border-top: 1px solid var(–border);
padding: 24px 40px;
max-width: 1100px;
margin: 0 auto;
display: flex;
justify-content: space-between;
align-items: center;
}

.footer-text {
font-family: var(–mono);
font-size: 10px;
color: var(–muted);
letter-spacing: 0.2em;
}

.progress-bar {
height: 3px;
background: var(–border);
width: 200px;
position: relative;
overflow: hidden;
}

.progress-fill {
height: 100%;
background: linear-gradient(90deg, var(–accent), var(–warn));
transition: width 0.3s ease;
}

/* RESPONSIVE */
@media (max-width: 768px) {
header, .doctrine, main { padding-left: 20px; padding-right: 20px; }
.header-grid { grid-template-columns: 1fr; }
.header-meta { text-align: left; }
h1 { font-size: 52px; }
.layers-grid { grid-template-columns: 1fr; }
.loop-stages { flex-direction: column; }
.loop-stage::after { display: none; }
.objectives-grid { grid-template-columns: 1fr; }
}
</style>

</head>
