<script>
  const answers = {};
  const correct = { q1: 'B', q2: 'C', q3: 'C' };
  const feedback = {
    q1: {
      B: "Correct. This is a dual signature: the contractor is exercising selective transparency (Contractor Drift) and the non-inspection has been normalized into a standing expectation (Inspection Drift). Both are active simultaneously — a compounding pattern.",
      default: "Not quite. The contractor's instruction not to inspect, combined with the framing that it's never inspected, shows both Contractor Drift (hiding information) and Inspection Drift (normalized non-inspection working together."
    },
    q2: {
      C: "Correct. Stages 1 and 2 are the intervention window. After Stage 2, normalization begins hardening. By Stage 3 the deviation becomes doctrine. By Stage 4 it becomes invisible. At Stage 5, someone is already dead.",
      default: "Incorrect. The intervention must occur at Stage 1 (Deviation) or Stage 2 (Normalization). Once drift reaches Stage 3, it has been institutionalized and new leaders will inherit it as the standard — they won't even know a deviation occurred."
    },
    q3: {
      C: "Correct. This is the textbook Drift Accumulation pathway: temporary → routine → invisible → catastrophic. Each rotation inherited the overload as the baseline. The original standard was erased without anyone making a deliberate decision to erase it.",
      default: "Incorrect. This is Drift Accumulation — the compounding of a single temporary deviation across multiple rotations until the original standard is completely lost. No single person decided to allow the overload permanently. It became invisible through accumulation."
    }
  };

  function answer(btn, qid, isCorrect, letter) {
    if (answers[qid]) return;
    answers[qid] = letter;

    const container = document.getElementById(qid);
    const allBtns = container.querySelectorAll('.quiz-option');
    const fb = document.getElementById(qid + '-fb');

    allBtns.forEach(b => b.classList.add('disabled'));

    if (isCorrect) {
      btn.classList.add('correct');
      fb.textContent = feedback[qid][letter];
      fb.className = 'feedback show correct-fb';
    } else {
      btn.classList.add('wrong');
      const correctText = feedback[qid].default;
      fb.textContent = correctText;
      fb.className = 'feedback show wrong-fb';
      // Highlight correct answer
      allBtns.forEach(b => {
        if (b.querySelector('.opt-letter').textContent === correct[qid]) {
          b.classList.add('correct');
        }
      });
    }

    updateScore();
  }

  function updateScore() {
    const total = Object.keys(correct).length;
    const done = Object.keys(answers).length;
    let score = 0;
    for (const q in answers) {
      if (answers[q] === correct[q]) score++;
    }
    const pct = Math.round((done / total) * 100);
    document.getElementById('progress').style.width = pct + '%';
    if (done === total) {
      document.getElementById('score-label').textContent = `SCORE: ${score}/${total}`;
    }
  }
</script>

